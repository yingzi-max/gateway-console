[Unit]
Description=Gateway Console administration service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gateway-console
Group=gateway-console
WorkingDirectory=@APP_DIR@
EnvironmentFile=/etc/gateway-console.env
ExecStart=/usr/bin/python3 @APP_DIR@/app.py --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=3
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@DATA_DIR@ /etc/nginx /var/log/nginx /run -/etc/letsencrypt -/var/lib/letsencrypt -/var/log/letsencrypt

[Install]
WantedBy=multi-user.target
