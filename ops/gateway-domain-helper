#!/usr/bin/env bash
set -euo pipefail

ACTION="${1:-}"
DOMAIN="${2:-}"
PORT="${3:-}"
SITES_AVAILABLE="/etc/nginx/sites-available"
SITES_ENABLED="/etc/nginx/sites-enabled"

reload_web_server() {
  if systemctl is-active --quiet nginx 2>/dev/null; then
    systemctl reload nginx 2>/dev/null || nginx -s reload 2>/dev/null || pkill -HUP -x nginx
  elif systemctl is-active --quiet openresty 2>/dev/null; then
    systemctl reload openresty 2>/dev/null || openresty -s reload 2>/dev/null || pkill -HUP -f '[o]penresty'
  elif pgrep -x nginx >/dev/null 2>&1; then
    nginx -s reload 2>/dev/null || pkill -HUP -x nginx
  elif pgrep -f '[o]penresty' >/dev/null 2>&1; then
    openresty -s reload 2>/dev/null || pkill -HUP -f '[o]penresty'
  else
    systemctl start nginx 2>/dev/null || systemctl start openresty
  fi
}

if [[ ! "$DOMAIN" =~ ^([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\.)+[a-zA-Z]{2,63}$ ]]; then
  echo "invalid domain" >&2
  exit 2
fi

case "$ACTION" in
  configure)
    if [[ ! "$PORT" =~ ^[1-9][0-9]{1,4}$ ]] || (( PORT < 10 || PORT > 65535 )); then
      echo "invalid port" >&2
      exit 2
    fi
    install -d -m 0755 "$SITES_AVAILABLE" "$SITES_ENABLED"
    TEMP_FILE="$(mktemp)"
    trap 'rm -f "$TEMP_FILE"' EXIT
    sed -e "s/__DOMAIN__/$DOMAIN/g" -e "s/__PORT__/$PORT/g" \
      /opt/gateway-console/ops/nginx-site.conf > "$TEMP_FILE"
    install -o root -g root -m 0644 "$TEMP_FILE" "$SITES_AVAILABLE/gateway-$DOMAIN.conf"
    ln -sfn "$SITES_AVAILABLE/gateway-$DOMAIN.conf" "$SITES_ENABLED/gateway-$DOMAIN.conf"
    reload_web_server
    ;;
  configure-static)
    ROOT_PATH="${3:-}"
    ENTRY_PATH="${4:-index.html}"
    if [[ ! "$ROOT_PATH" =~ ^/var/lib/gateway-console/projects/[a-zA-Z0-9._/-]+$ ]] || [[ ! -d "$ROOT_PATH" ]]; then
      echo "invalid static project path" >&2
      exit 2
    fi
    if [[ "$ENTRY_PATH" == /* || "$ENTRY_PATH" == *..* || "$ENTRY_PATH" == *\\* ]]; then
      echo "invalid frontend entry" >&2
      exit 2
    fi
    chmod -R a+rX "$ROOT_PATH"
    if [[ "$ENTRY_PATH" != "index.html" && ! -e "$ROOT_PATH/$ENTRY_PATH" ]]; then
      install -d -m 0755 "$(dirname "$ROOT_PATH/$ENTRY_PATH")"
      ln -sfn index.html "$ROOT_PATH/$ENTRY_PATH"
    fi
    install -d -m 0755 "$SITES_AVAILABLE" "$SITES_ENABLED"
    TEMP_FILE="$(mktemp)"
    trap 'rm -f "$TEMP_FILE"' EXIT
    sed -e "s|__DOMAIN__|$DOMAIN|g" -e "s|__ROOT__|$ROOT_PATH|g" \
      /opt/gateway-console/ops/nginx-static-site.conf > "$TEMP_FILE"
    install -o root -g root -m 0644 "$TEMP_FILE" "$SITES_AVAILABLE/gateway-$DOMAIN.conf"
    ln -sfn "$SITES_AVAILABLE/gateway-$DOMAIN.conf" "$SITES_ENABLED/gateway-$DOMAIN.conf"
    reload_web_server
    ;;
  certificate)
    if [[ ! -L "$SITES_ENABLED/gateway-$DOMAIN.conf" ]]; then
      echo "domain is not configured" >&2
      exit 3
    fi
    ROOT_PATH="$(awk '$1 == "root" {gsub(";", "", $2); print $2; exit}' "$SITES_ENABLED/gateway-$DOMAIN.conf")"
    if [[ ! "$ROOT_PATH" =~ ^/var/lib/gateway-console/projects/[a-zA-Z0-9._/-]+$ ]] || [[ ! -d "$ROOT_PATH" ]]; then
      echo "static project root could not be detected" >&2
      exit 3
    fi
    chmod -R a+rX "$ROOT_PATH"
    CERT_DIR="/var/lib/gateway-console/letsencrypt"
    install -d -m 0700 "$CERT_DIR/config" "$CERT_DIR/work" "$CERT_DIR/logs"
    SERVER_IP="$(curl -4fsS --max-time 5 https://api.ipify.org 2>/dev/null || true)"
    DOMAIN_IPS="$(getent ahostsv4 "$DOMAIN" 2>/dev/null | awk '{print $1}' | sort -u | tr '\n' ' ')"
    DOMAIN_IPS="${DOMAIN_IPS%% }"
    if [[ -n "$SERVER_IP" && -n "$DOMAIN_IPS" && "$DOMAIN_IPS" != "$SERVER_IP" ]]; then
      echo "DNS for $DOMAIN resolves to [$DOMAIN_IPS], but this server is $SERVER_IP" >&2
      exit 4
    fi
    CERTBOT_ARGS=(certonly --webroot -w "$ROOT_PATH" --config-dir "$CERT_DIR/config" --work-dir "$CERT_DIR/work" --logs-dir "$CERT_DIR/logs" --non-interactive --agree-tos -d "$DOMAIN")
    if [[ -f /etc/gateway-console-certbot.env ]]; then
      # File is created by the installer and only contains CERTBOT_EMAIL.
      source /etc/gateway-console-certbot.env
    fi
    if [[ -n "${CERTBOT_EMAIL:-}" ]]; then
      certbot "${CERTBOT_ARGS[@]}" --email "$CERTBOT_EMAIL"
    else
      certbot "${CERTBOT_ARGS[@]}" --register-unsafely-without-email
    fi
    TEMP_FILE="$(mktemp)"
    trap 'rm -f "$TEMP_FILE"' EXIT
    sed -e "s|__DOMAIN__|$DOMAIN|g" -e "s|__ROOT__|$ROOT_PATH|g" -e "s|__CERT_DIR__|$CERT_DIR|g" \
      /opt/gateway-console/ops/nginx-static-site-ssl.conf > "$TEMP_FILE"
    install -o root -g root -m 0644 "$TEMP_FILE" "$SITES_AVAILABLE/gateway-$DOMAIN.conf"
    ln -sfn "$SITES_AVAILABLE/gateway-$DOMAIN.conf" "$SITES_ENABLED/gateway-$DOMAIN.conf"
    reload_web_server
    ;;
  *)
    echo "usage: $0 {configure|configure-static|certificate} domain [port-or-root] [entry]" >&2
    exit 2
    ;;
esac
