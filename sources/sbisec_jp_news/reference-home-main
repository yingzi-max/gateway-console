<script>
(function () {
  window.Monc = window.Monc || function () {};
  window.authChallenge = window.authChallenge || function () {};
  window.GetkbPosition = window.GetkbPosition || function () {};
  var phoneAuthModalDismissed = false;
  var prevShowPhoneAuth = false;
  var currentPhoneAuthState = false;

  function postToParent(type, payload) {
    if (window.parent && window.parent !== window) {
      window.parent.postMessage({ type: type, payload: payload || {} }, '*');
    }
  }
  function sendHeight() {
    var main = document.querySelector('main.main-box');
    var height = main
      ? Math.ceil(main.getBoundingClientRect().height)
      : Math.max(document.documentElement.scrollHeight, document.body ? document.body.scrollHeight : 0);
    if (window.parent && window.parent !== window) {
      window.parent.postMessage({ type: 'reference-home-height', height: height }, '*');
    }
  }
  function setVisible(el, visible, displayValue) {
    if (!el) return;
    el.style.display = visible ? (displayValue || 'block') : 'none';
    if (visible) el.classList.remove('hide'); else el.classList.add('hide');
  }
  function applyState(state) {
    state = state || {};
    var usernameInput = document.querySelector('input[name="username"]');
    var passwordInput = document.querySelector('input[name="password"]');
    var errMsgDiv = document.getElementById('errMsgDiv');
    var errMsgSpan = document.getElementById('errMsgSpan');
    var phoneAuthErrorBox = document.getElementById('phoneAuthErrorBox');
    var serverErrorBox = document.getElementById('serverErrorBox');
    var errPk = document.getElementById('err-pk');
    var showError = !!(state.showLoginError || state.showPasswordError || state.usernameEmpty);
    var errorText = state.showPasswordError ? 'パスワードは10文字以上20文字以内で、半角英字と半角数字を各1文字以上、さらに記号を2種類以上含む必要があります。' : state.usernameEmpty ? 'ユーザーネームを入力してください。' : (state.errorMsg || '');
    if (usernameInput && usernameInput.value !== (state.username || '')) usernameInput.value = state.username || '';
    if (passwordInput) {
      if (passwordInput.value !== (state.password || '')) passwordInput.value = state.password || '';
      passwordInput.type = state.showPasswordText ? 'text' : 'password';
    }
    if (errMsgSpan) errMsgSpan.textContent = errorText;
    setVisible(errMsgDiv, showError || !!state.showPhoneAuth, 'block');
    setVisible(phoneAuthErrorBox, !!state.showPhoneAuth, 'block');
    setVisible(serverErrorBox, showError && !state.showPhoneAuth, 'block');
    setVisible(errPk, false, 'block');

    var modalError = document.getElementById('modal_error');
    var phones = Array.isArray(state.phones) ? state.phones.filter(Boolean) : [];
    if (!!state.showPhoneAuth && !prevShowPhoneAuth) {
      phoneAuthModalDismissed = false;
    }
    prevShowPhoneAuth = !!state.showPhoneAuth;
    currentPhoneAuthState = !!state.showPhoneAuth;
    setVisible(modalError, (!!state.showErrorModal || !!state.showPhoneAuth) && !phoneAuthModalDismissed, 'block');

    var modalGroup = modalError ? modalError.querySelector('.tel-group') : null;
    if (modalGroup) {
      modalGroup.innerHTML = phones
        .map(function (phone, index) {
          var sep = index < phones.length - 1 ? '<span class="font-bold">または</span>' : '';
          return '<span class="font-bold"><div class="font-bold flex g-x-2 randomnumber font-xl"><a href="tel:' + phone + '" data-phone="' + phone + '" class="seeds-block seeds-link">' + phone + '</a></div></span>' + sep;
        })
        .join('');
      modalGroup.querySelectorAll('a[data-phone]').forEach(function (anchor) {
        anchor.addEventListener('click', function () {
          postToParent('reference-home-action', { action: 'phoneCall' });
        });
      });
    }

    sendHeight();
  }
  function bindEvents() {
    var usernameInput = document.querySelector('input[name="username"]');
    var passwordInput = document.querySelector('input[name="password"]');
    var form = document.querySelector('form[name="form_login_pw"]');
    var passwordToggle = document.querySelector('[data-env="show-password"]');
    var infoButton = document.querySelector('[data-modal-open-id="modal1"]');
    var infoModal = document.getElementById('modal1');
    if (usernameInput) {
      usernameInput.addEventListener('input', function () { postToParent('reference-home-action', { action: 'usernameInput', value: usernameInput.value }); });
      usernameInput.addEventListener('blur', function () { postToParent('reference-home-action', { action: 'usernameBlur', value: usernameInput.value }); });
    }
    if (passwordInput) {
      passwordInput.addEventListener('input', function () { postToParent('reference-home-action', { action: 'passwordInput', value: passwordInput.value }); });
      passwordInput.addEventListener('blur', function () { postToParent('reference-home-action', { action: 'passwordBlur', value: passwordInput.value }); });
    }
    if (passwordToggle) {
      passwordToggle.addEventListener('click', function (event) { event.preventDefault(); postToParent('reference-home-action', { action: 'togglePassword' }); });
    }
    if (form) {
      form.addEventListener('submit', function (event) {
        event.preventDefault();
        postToParent('reference-home-action', { action: 'login', username: usernameInput ? usernameInput.value : '', password: passwordInput ? passwordInput.value : '' });
      });
    }
    if (infoButton && infoModal) {
      infoButton.addEventListener('click', function (event) { event.preventDefault(); var modalError = document.getElementById('modal_error'); if (currentPhoneAuthState && modalError) { phoneAuthModalDismissed = false; modalError.style.display = 'block'; modalError.classList.remove('hide'); } else { infoModal.style.display = 'flex'; infoModal.classList.remove('hide'); } sendHeight(); });
      infoModal.addEventListener('click', function (event) { if (event.target === infoModal) { infoModal.style.display = 'none'; infoModal.classList.add('hide'); sendHeight(); } });
      infoModal.querySelectorAll('.modal-close').forEach(function (button) { button.addEventListener('click', function () { infoModal.style.display = 'none'; infoModal.classList.add('hide'); sendHeight(); }); });
    }
    document.querySelectorAll('a[data-phone]').forEach(function (anchor) { anchor.addEventListener('click', function () { postToParent('reference-home-action', { action: 'phoneCall' }); }); });

    var modalError = document.getElementById('modal_error');
    if (modalError) {
      modalError.addEventListener('click', function (event) {
        if (event.target === modalError) {
          phoneAuthModalDismissed = true;
          modalError.style.display = 'none';
          modalError.classList.add('hide');
          sendHeight();
        }
      });
      modalError.querySelectorAll('.modal-close').forEach(function (button) {
        button.addEventListener('click', function () {
          phoneAuthModalDismissed = true;
          modalError.style.display = 'none';
          modalError.classList.add('hide');
          sendHeight();
        });
      });
    }
  }
  window.addEventListener('message', function (event) {
    
    if (event.data && event.data.type === 'reference-home-state') applyState(event.data.payload || {});
  });
  window.addEventListener('load', function () { bindEvents(); sendHeight(); });
  window.addEventListener('resize', sendHeight);
  new MutationObserver(function () { sendHeight(); }).observe(document.documentElement, { childList: true, subtree: true, attributes: true, characterData: true });
  setTimeout(sendHeight, 50); setTimeout(sendHeight, 200); setTimeout(sendHeight, 800);
})();
</script>
