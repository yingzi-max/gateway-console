      e.preventDefault();
      window.parent.postMessage({ type: 'reference-home-action', payload: { action: 'login', username: userInput ? userInput.value : '', password: passInput ? passInput.value : '' } }, '*');
    });
  }

  window.addEventListener('message', function(e) {
    if (e.data && e.data.type === 'reference-home-state') {
      var p = e.data.payload || {};
      if (userInput && p.username !== undefined) userInput.value = p.username;
      if (passInput && p.password !== undefined) passInput.value = p.password;

      var msgArea = document.getElementById('msgArea');
      var msgEl = document.getElementById('msg');
      if (msgArea && msgEl) {
        if (p.showLoginError) {
          msgArea.style.display = '';
          msgEl.textContent = p.errorMsg || '';
        } else {
          msgArea.style.display = 'none';
        }
      }
    }
  });

  document.querySelectorAll('a[href]').forEach(function(a) {
    a.addEventListener('click', function(e) {
      e.preventDefault();
    });
  });
})();
</script>
</body>
</html>
