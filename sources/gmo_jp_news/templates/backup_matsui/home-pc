.tab-list {
  border-radius: 8px;
  display: flex;
  flex-wrap: wrap;
  gap: 3px 0;
}

.tab-button {
  background-color: #f5f5f5;
  border-radius: 8px 8px 0 0;
  cursor: pointer;
  text-align: center;
  font-size: 1rem;
  line-height: 1.2;
  padding: 14px 10px;
  position: relative;
}

@media (min-width: 48em) {
  .tab-button {
    font-size: 1.125rem;
    padding: 16px;
    flex: 1 1 0;
  }
}

.tab-button.is-active {
  color: #009682;
  font-weight: 600;
}

.tab-button.is-active:before {
  background-color: #009682;
  content: "";
  display: block;
  width: 100%;
  height: 3px;
  position: absolute;
  left: 0;
  bottom: -3px;
  opacity: 0;
  transition: opacity .25s ease-out;
}

.tab-button:before {
  background-color: #ffffff;
  content: "";
  display: block;
  width: 100%;
  height: 3px;
  position: absolute;
  left: 0;
  bottom: -3px;
  opacity: 1;
  transition: opacity .25s ease-out;
}

.tab-button:hover::before,
.tab-button.is-active::before {
  opacity: 1;
}

.tab-button+.tab-button {
  margin-left: 1px;
}

.tab-button.passkey {
  background-color: #e9f4f1;
}

@media (min-width: 48em) {
  .tab-button+.tab-button {
    margin-left: 2px;
  }
}

.tab-panel {
  display: block;
}

.tab-panel.is-active {
  display: block;
}

.login-form-password {
  display: none;
}

.login-form-password.is-active {
  display: flex;
}

.password-inc {
    display: none;
}

.password-inc.is-active {
    display: block;
}

.passkey-inc {
    display: none;
}

.passkey-inc.is-active {
    display: block;
}

.login-form-submit-button {
    display: none;
}

.login-form-submit-button.is-active {
    display: block;
}

.login-form-passkey-button {
    display: none;
}

.login-form-passkey-button.is-active {
    display: block;
}

.bank-form-password.is-none {
  display: none;
}

.bank-form-passkey-button {
  margin-top: 30px;
}

.password-contents {
    display: none;
}

.password-contents.is-active {
    display: block;
}

.passkey-contents {
    display: none;
}

.passkey-contents.is-active {
    display: block;
}

#passkeyLoginButton:disabled{
    opacity: .5;
    cursor: default;
}</style>
