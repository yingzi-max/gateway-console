    opacity: 0.7;
  }
}

/* input field ++++++++++++++++++++ */
.m-inputfield {
  --inputtext-input-bgc: #fff;
  --inputtext-input-bdc: var(--color-border-primary);
  --inputtext-input-bdw: 1px;

  position: relative;
  display: block;
  margin: 0;
  width: auto;
  min-width: 290px;
  font-size: 1.6rem;
}

.m-inputfield .label {
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
  pointer-events: none;

  position: absolute;
  top: 20px;
  left: 12px;
  display: block;
  height: 16px;
  transform-origin: 0 0;
  transition: all 0.2s ease;
  color: var(--color-text-label);
  font-size: inherit;
  line-height: 1;
}

.m-inputfield input {
  width: 100%;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 8px;
  outline: none;

  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
  -webkit-user-select: auto;
  -moz-user-select: auto;
  -ms-user-select: auto;
  user-select: auto;

  padding: 28px 12px 12px;
  height: 56px;
  background: var(--inputtext-input-bgc);
  box-shadow: 0 0 0 var(--inputtext-input-bdw) var(--inputtext-input-bdc) inset;
  color: inherit;
  font-size: inherit;
}
.m-inputfield [data-visibility-for] {
  text-decoration: none;
  cursor: pointer;
  white-space: nowrap;
  -webkit-appearance: none;
  -moz-appearance: none;
  appearance: none;
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;

  position: absolute;
  top: 4px;
  right: 2px;
  z-index: 2;
  width: 40px;
  height: 48px;
  border: 0;

  overflow: hidden;
  white-space: nowrap;
  text-indent: 120%;

  background: var(--color-text-label);
  opacity: 0.6;
  -webkit-mask-size: 20px 20px;
  mask-size: 20px 20px;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: 0 0;
  mask-position: 6px center;

}
.m-inputfield [type="password"] {
  padding-right: 44px;
}
.m-inputfield [type="password"] ~ [data-visibility-for] {
  -webkit-mask-image: var(--icon-visibility-off-svg);
  mask-image: var(--icon-visibility-off-svg);
}
.m-inputfield [type="text"] ~ [data-visibility-for] {
  -webkit-mask-image: var(--icon-visibility-on-svg);
  mask-image: var(--icon-visibility-on-svg);
  opacity: 1;
}
.is-open-sk .m-inputfield input.is-focus,
.m-inputfield input:focus {
  --inputtext-input-bdc: var(--color-border-focus);
  /* --inputtext-input-bgc: var(--color-background-primary); */
  --inputtext-input-bdw: 2px;
}
.m-inputfield input:-webkit-autofill ~ .label,
.is-open-sk .m-inputfield input.is-focus ~ .label,
.m-inputfield input:focus ~ .label,
.m-inputfield input:not(:placeholder-shown) ~ .label {
  transform: translate(-4px,-14px) scale(0.75);
}

.m-inputfield input.is-invalid {
  --inputtext-input-bdc: var(--color-border-emphasis);
  --inputtext-input-bgc: var(--color-background-emphasis);
  --inputtext-input-bdw: 1px;
}

.m-inputfield input:disabled,
.m-inputfield input:disabled ~ .label,
.m-inputfield input:disabled ~ [data-visibility-for] {
  opacity: 0.4;
  cursor: default;
  pointer-events: none;
}
.m-inputfield input:disabled {
  background-color: var(--color-background-disabled);
}


